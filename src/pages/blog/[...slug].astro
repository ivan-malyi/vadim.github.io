---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config';
import { url, formatDate, readingTime } from '../../lib/url';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
interface Props { post: CollectionEntry<'blog'>; newer?: CollectionEntry<'blog'>; older?: CollectionEntry<'blog'> }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const { title, description, date, updated, tags } = post.data;
---
<BaseLayout title={title} description={description} type="article">
  <article class="container post">
    <header class="post-head">
      <a class="back" href={url('blog')}><Icon name="arrow" size={16} class="flip" /> Все записи</a>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta">
        <span>{SITE.name}</span>
        <span class="sep">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <><span class="sep">·</span><span>обновлено {formatDate(updated)}</span></>}
        <span class="sep">·</span>
        <span>{readingTime(post.body)} мин</span>
      </div>
      {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="chip">#{t}</span>)}</div>}
    </header>

    <div class="post-grid">
      <div class="prose content"><Content /></div>
      {toc.length >= 3 && (
        <nav class="toc" aria-label="Содержание">
          <p class="eyebrow">Содержание</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </div>

    <nav class="pager" aria-label="Другие записи">
      {older ? (
        <a href={url(`blog/${older.id}`)}><span class="eyebrow">← Ранее</span><span>{older.data.title}</span></a>
      ) : <span />}
      {newer && (
        <a class="right" href={url(`blog/${newer.id}`)}><span class="eyebrow">Новее →</span><span>{newer.data.title}</span></a>
      )}
    </nav>
  </article>
</BaseLayout>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length) {
    const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) { links.forEach((l) => l.classList.remove('on')); map.get(e.target.id)?.classList.add('on'); }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });
    document.querySelectorAll('.content h2[id]').forEach((h) => io.observe(h));
  }
</script>

<style>
  .post-head { max-width: var(--maxw-prose); padding-block: clamp(32px, 6vw, 72px) 40px; }
  .back { display: inline-flex; gap: 8px; align-items: center; font-size: 14px; color: var(--ink-3); text-decoration: none; margin-bottom: 32px; }
  .back :global(.flip) { transform: rotate(180deg); }
  .back:hover { color: var(--accent); }
  h1 { font-size: clamp(34px, 5.5vw, 56px); letter-spacing: -0.025em; }
  .lede { font: 400 21px/1.5 var(--font-serif); color: var(--ink-2); margin: 20px 0 24px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--ink-3); }
  .sep { opacity: .5; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }

  .post-grid { display: grid; grid-template-columns: minmax(0, var(--maxw-prose)) 1fr; gap: 64px; padding-top: 40px; border-top: 1px solid var(--line); }
  .toc { position: sticky; top: 100px; align-self: start; font-size: 14px; }
  .toc ol { list-style: none; padding: 0; margin: 14px 0 0; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 5px 0 5px 16px; margin-left: -1px; border-left: 2px solid transparent; color: var(--ink-3); text-decoration: none; line-height: 1.4; }
  .toc a:hover { color: var(--ink); }
  .toc a.on { color: var(--accent); border-left-color: var(--accent); }
  @media (max-width: 1060px) { .post-grid { grid-template-columns: minmax(0, 1fr); } .toc { display: none; } }

  .content :global(h2), .content :global(h3) { scroll-margin-top: 90px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: var(--maxw-prose); margin-top: 72px; }
  .pager a { display: flex; flex-direction: column; gap: 6px; padding: 20px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; background: var(--bg-elev); font: 500 17px/1.35 var(--font-serif); transition: border-color .15s; }
  .pager a:hover { border-color: var(--accent); color: var(--ink); }
  .pager .right { text-align: right; grid-column: 2; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .right { grid-column: auto; } }
</style>
