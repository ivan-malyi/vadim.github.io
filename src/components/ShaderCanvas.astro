---
/**
 * WebGL2-холст для фрагментного шейдера (в стиле Shadertoy).
 *
 * Шейдер должен определить: void mainImage(out vec4 fragColor, in vec2 fragCoord)
 * Доступные uniform-переменные:
 *   iResolution (vec3), iTime (float), iMouse (vec4: xy — курсор, z — нажатие)
 *   uBg, uInk, uAccent, uWarm (vec3) — цвета текущей темы сайта
 */
interface Props {
  frag: string;
  title?: string;
  height?: number | string;
  bare?: boolean; // без рамки — для фонов
  class?: string;
}
const { frag, title = 'WebGL', height = 360, bare = false, class: cls } = Astro.props;
const h = typeof height === 'number' ? `${height}px` : height;
---
{bare ? (
  <div class:list={['shader bare', cls]} data-shader={frag} style={`height:${h}`}>
    <canvas aria-hidden="true"></canvas>
  </div>
) : (
  <figure class:list={['widget shader-widget not-prose', cls]}>
    <div class="widget-head">
      <span class="widget-title">{title}</span>
      <span class="widget-tag">webgl</span>
    </div>
    <div class="shader" data-shader={frag} style={`height:${h}`}>
      <canvas role="img" aria-label={title}></canvas>
      <button class="shader-toggle" type="button" aria-label="Пауза">❚❚</button>
      <p class="shader-fallback">Ваш браузер не поддерживает WebGL2.</p>
    </div>
  </figure>
)}

<script>
  const VERT = `#version 300 es
  in vec2 p; void main(){ gl_Position = vec4(p, 0., 1.); }`;
  const HEADER = `#version 300 es
  precision highp float;
  uniform vec3 iResolution; uniform float iTime; uniform vec4 iMouse;
  uniform vec3 uBg, uInk, uAccent, uWarm;
  out vec4 outColor;
  `;
  const FOOTER = `
  void main(){ vec4 c; mainImage(c, gl_FragCoord.xy); outColor = c; }`;

  const probe = document.createElement('span');
  function cssColor(varName: string): [number, number, number] {
    probe.style.color = `var(${varName})`;
    if (!probe.isConnected) { probe.style.display = 'none'; document.body.appendChild(probe); }
    const m = getComputedStyle(probe).color.match(/[\d.]+/g) || ['0', '0', '0'];
    return [+m[0] / 255, +m[1] / 255, +m[2] / 255];
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-shader]').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const gl = canvas.getContext('webgl2', { antialias: true, premultipliedAlpha: true, alpha: true });
    if (!gl) { root.classList.add('no-gl'); return; }

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src); gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, HEADER + root.dataset.shader + FOOTER));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { console.error(gl.getProgramInfoLog(prog)); root.classList.add('no-gl'); return; }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const U = (n: string) => gl.getUniformLocation(prog, n);
    const uRes = U('iResolution'), uTime = U('iTime'), uMouse = U('iMouse');
    const setTheme = () => {
      gl.uniform3fv(U('uBg'), cssColor('--bg'));
      gl.uniform3fv(U('uInk'), cssColor('--ink'));
      gl.uniform3fv(U('uAccent'), cssColor('--accent'));
      gl.uniform3fv(U('uWarm'), cssColor('--warm'));
    };
    setTheme();

    const mouse = [0, 0, 0, 0];
    let tgt = [0, 0];
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 1.75);
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * dpr));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * dpr));
      gl.viewport(0, 0, canvas.width, canvas.height);
      if (!mouse[0]) { mouse[0] = tgt[0] = canvas.width * 0.7; mouse[1] = tgt[1] = canvas.height * 0.5; }
      if (!running) frame(performance.now());
    };
    const host = root.closest('[data-shader-host]') as HTMLElement | null;
    (host ?? canvas).addEventListener('pointermove', (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      const s = canvas.width / r.width;
      tgt = [(e.clientX - r.left) * s, (r.bottom - e.clientY) * s];
    });
    canvas.addEventListener('pointerdown', () => (mouse[2] = 1));
    addEventListener('pointerup', () => (mouse[2] = 0));

    let running = false, visible = false, paused = reduced, t = reduced ? 12 : 0, last = 0;
    function frame(now: number) {
      const dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
      last = now;
      if (!paused) t += dt;
      mouse[0] += (tgt[0] - mouse[0]) * 0.06;
      mouse[1] += (tgt[1] - mouse[1]) * 0.06;
      gl!.uniform3f(uRes, canvas.width, canvas.height, 1);
      gl!.uniform1f(uTime, t);
      gl!.uniform4fv(uMouse, mouse);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      if (running) requestAnimationFrame(frame);
    }
    const update = () => {
      const should = visible && !paused && !document.hidden;
      if (should && !running) { running = true; last = 0; requestAnimationFrame(frame); }
      else if (!should) running = false;
    };

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; update(); }).observe(canvas);
    document.addEventListener('visibilitychange', update);
    const retheme = () => setTimeout(() => { setTheme(); if (!running) frame(performance.now()); }, 0);
    addEventListener('themechange', retheme);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', retheme);

    const btn = root.querySelector<HTMLButtonElement>('.shader-toggle');
    const syncBtn = () => { if (btn) { btn.textContent = paused ? '▶' : '❚❚'; btn.setAttribute('aria-label', paused ? 'Запустить' : 'Пауза'); } };
    btn?.addEventListener('click', () => { paused = !paused; syncBtn(); update(); });
    syncBtn();
  });
</script>

<style>
  .shader { position: relative; width: 100%; }
  .shader canvas { width: 100%; height: 100%; display: block; }
  .shader-widget .shader { background: var(--bg-sunken); }
  .shader-toggle {
    position: absolute; right: 12px; bottom: 12px;
    width: 34px; height: 34px; border-radius: 999px; border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-elev) 85%, transparent); color: var(--ink-2);
    font-size: 11px; cursor: pointer; backdrop-filter: blur(6px);
  }
  .shader-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .shader-fallback { display: none; position: absolute; inset: 0; margin: 0; place-items: center; color: var(--ink-3); font-size: 14px; }
  .no-gl .shader-fallback { display: grid; }
  .no-gl canvas, .no-gl .shader-toggle { display: none; }
</style>
